# ==========================================
# LLM Configuration
# ==========================================
# Default LLM Provider (OpenAI, DeepSeek, vLLM, etc.)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o
LLM_TIMEOUT=180.0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0

# Optional secondary/summary model
SUMMARY_MODEL_NAME=gpt-4o-mini

# ==========================================
# Search & Extraction Provider Keys (Optional)
# ==========================================
# Tavily Search API (Preferred for clean search extracts)
TAVILY_API_KEY=

# Google Serper API (Google Search Fallback)
SERPER_API_KEY=

# Jina Reader API (Clean Web Scraping)
JINA_API_KEY=

# ==========================================
# System Settings
# ==========================================
LOG_LEVEL=INFO
MAX_INPUT_TOKENS=64000
OBS_MAX_CHARS=30000
DEFAULT_WORKSPACE=./workspace
